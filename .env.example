# Copy to .env and fill in. .env is gitignored.

# Primary judge (OpenAI-compatible), read by scripts/04_evaluate.sh and src/eval/compute_gemba.py.
# docs/evaluation.md#serve-the-judge shows how to serve a judge at this address.
OPENAI_API_KEY=EMPTY
OPENAI_BASE_URL=http://localhost:8000/v1
JUDGE_MODEL_NAME=qwen3.6-35b-a3b-fp8
ALPACA_EVAL_REQUEST_DELAY=0

# Cross-judge defaults for src/eval/cross_judge.py, which also takes --base-url and --model.
# Export them first, for example with: set -a && source .env && set +a
# CROSS_JUDGE_BASE_URL=http://localhost:8001/v1
# CROSS_JUDGE_API_KEY=EMPTY
# CROSS_JUDGE_MODEL=gpt-oss-120b
